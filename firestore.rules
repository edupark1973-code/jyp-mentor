rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDesignatedMentor() {
      return isSignedIn() && request.auth.token.email == 'edupark1973@gmail.com';
    }

    function isMentor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor';
    }

    function hasValidRole() {
      return request.resource.data.role in ['mentor', 'mentee'];
    }
    
    // 1. [수정] 사용자 규칙: 알림 발송을 위해 이메일 정보 읽기는 로그인한 사용자에게 허용
    match /users/{userId} {
      // 읽기: 로그인한 사용자는 강사의 이메일을 알아야 알림을 보낼 수 있으므로 허용
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid && hasValidRole() &&
        request.resource.data.role == (isDesignatedMentor() ? 'mentor' : 'mentee');
      allow update: if hasValidRole() && (
        isMentor() ||
        (request.auth.uid == userId && request.resource.data.uid == request.auth.uid && (
          request.resource.data.role == resource.data.get('role', '') ||
          (request.resource.data.role == 'mentee' &&
            !(resource.data.get('role', '') in ['mentor', 'mentee'])) ||
          (isDesignatedMentor() && request.resource.data.role == 'mentor')
        ))
      );
      allow delete: if isMentor();
    }
    
    // 2. [추가] 메일 발송 규칙: Trigger Email 익스텐션이 감시하는 컬렉션
    match /mail/{mailId} {
      // 수강생이 예약 시 이 컬렉션에 문서를 '생성'할 수 있어야 함
      allow create: if request.auth != null;
      // 보안을 위해 아무나 읽거나 수정하는 것은 금지
      allow read, update, delete: if false;
    }
    
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isMentor();
    }
    
    match /cards/{cardId} {
      allow read: if true;
      allow write: if isMentor();
    }
    
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true; // 익명 댓글 허용
      allow delete: if isMentor();
    }
    
    match /votes/{voteId} {
      allow read: if true;
      allow create: if true; // 익명 참여 허용
    }
    
    match /independent_polls/{pollId} {
      allow read: if true;
      allow write: if true; 
    }
    
    match /mentoring_slots/{slotId} {
      allow read: if true;
      allow create, delete: if isMentor();
      allow update: if request.auth != null; 
    }
    
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read: if isSignedIn() && (resource.data.menteeId == request.auth.uid || isMentor());
      allow update: if isMentor();
      allow delete: if isSignedIn() && (resource.data.menteeId == request.auth.uid || isMentor());
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (resource.data.menteeId == request.auth.uid || isMentor());
      allow create: if isSignedIn() && request.resource.data.menteeId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.menteeId == request.auth.uid || isMentor());
    }

    match /step_results/{resultId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.menteeId == request.auth.uid ||
        isMentor()
      );
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.menteeId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.menteeId == request.auth.uid ||
        isMentor()
      );
    }

    match /mentor_feedbacks/{feedbackId} {
      // 새 프로젝트에는 아직 피드백 문서가 없을 수 있으므로 빈 문서 조회를 허용한다.
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/mentor_feedbacks/$(feedbackId)) ||
        get(/databases/$(database)/documents/projects/$(feedbackId)).data.menteeId == request.auth.uid ||
        isMentor()
      );
      allow list: if isMentor();
      allow create, update, delete: if isMentor();
    }
    
    match /lectures/{id} { allow read, write: if true; }
    match /materials/{id} { allow read, write: if true; }
    match /questions/{id} { allow read, write: if true; }
  }
}
